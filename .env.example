# Alpaca (paper) — get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_CRYPTO_STREAM_URL=wss://stream.data.alpaca.markets/v1beta3/crypto/us
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# State store (SQLite) — path resolved relative to process CWD
STATE_DB_PATH=./state/singularity.db

# Executor
EXECUTOR_HEARTBEAT_S=15
PASSIVE_T1_S=10           # cancel/replace at touch after T1
PASSIVE_T2_S=60           # replace at mid after T2
PASSIVE_T3_S=180          # cross with IOC after T3

# InfluxDB (local docker defaults — override if remote)
INFLUX_URL=http://localhost:47086
INFLUX_TOKEN=dev-token-change-me
INFLUX_ORG=singularity
INFLUX_BUCKET_RAW=crypto_raw
INFLUX_BUCKET_FEATURES=crypto_features

# Symbols to subscribe (comma-separated)
STREAM_TRADES=BTC/USD
STREAM_QUOTES=BTC/USD,ETH/USD,ETH/BTC
STREAM_ORDERBOOKS=BTC/USD,ETH/USD

# Book feature cadence (seconds)
BOOK_FEATURE_CADENCE_S=1

# Logging
LOG_LEVEL=INFO
